# Modelo do arquivo de ambiente para rodar LOCAL (fase 1).
# Copie para `.env` e preencha. `.env` está no .gitignore e NUNCA é commitado.
# Em produção nada disto vem de arquivo: vem do Secret Manager, montado como
# variável de ambiente pelo Cloud Run.

# --- Obrigatório ---
# Token da Replicate: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Gasto ---
TETO_DIARIO_USD=10
FUSO_HORARIO=America/Sao_Paulo

# --- Armazenamento ---
# Vazio = grava as imagens em ./.imagens-locais (fase 1, sem GCP).
GCS_BUCKET=
URL_ASSINADA_MINUTOS=60

# --- Autenticação ---
# Local, com o inspector do MCP, basta um token estático qualquer.
# Em produção este campo fica VAZIO e quem protege é o OAuth.
MCP_STATIC_TOKEN=token-so-de-desenvolvimento

# OAuth (fase 3, produção). Ligado sozinho quando roda no Cloud Run.
OAUTH_HABILITADO=false
BASE_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SENHA=
OAUTH_ASSINATURA=
